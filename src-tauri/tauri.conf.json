{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AltDeck",
  "version": "0.2.1",
  "identifier": "dev.altdeck.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "AltDeck", "width": 1440, "height": 960,
      "minWidth": 980, "minHeight": 680, "center": true,
      "backgroundColor": "#101114"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https://*.rbxcdn.com; font-src 'self'; connect-src ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'self'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true, "targets": ["nsis"], "category": "Utility",
    "shortDescription": "Local Roblox account manager",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": { "installMode": "currentUser", "displayLanguageSelector": true, "languages": ["Russian", "English"] }
    }
  }
}
